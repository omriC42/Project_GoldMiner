# hook_speed_test.qsf - Step 3.5 standalone hook speed test
# Uses the game's own files through ../ paths, so it tests exactly the game's hook code.
# Pin assignments copied 1:1 from ../Lab1Demo.qsf (same port names as the game's top level).
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSXFC6D6F31C6
set_global_assignment -name TOP_LEVEL_ENTITY hook_speed_test_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 17.0.0
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85

# ---- hook (the game's files - package first) ----
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/VGA/hook_params.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/VGA/hook_move.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/VGA/hook_draw.sv
# ---- clock, VGA, keyboard (the game's files) ----
set_global_assignment -name QIP_FILE ../CLK_31P5.qip
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/VGA/VGA_Controller.sv
set_global_assignment -name BDF_FILE ../RTL/KEYBOARDX/TOP_KBD.bdf
set_global_assignment -name SYSTEMVERILOG_FILE ../RTL/KEYBOARDX/keyPad_decoder.sv
set_global_assignment -name QXP_FILE ../KBDINTF.qxp
# ---- this test ----
set_global_assignment -name SYSTEMVERILOG_FILE hook_speed_test_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE hook_speed_test_top.sv
set_global_assignment -name SDC_FILE hook_speed_test.sdc

# ---- pins (copied from ../Lab1Demo.qsf) ----
set_location_assignment PIN_AF14 -to CLOCK_50
set_location_assignment PIN_AF9 -to redLight
set_location_assignment PIN_AE7 -to yellowLight
set_location_assignment PIN_AE11 -to greenLight
set_location_assignment PIN_AK22 -to OVGA[27]
set_location_assignment PIN_AJ21 -to OVGA[16]
set_location_assignment PIN_AJ20 -to OVGA[17]
set_location_assignment PIN_AH20 -to OVGA[18]
set_location_assignment PIN_AJ19 -to OVGA[19]
set_location_assignment PIN_AH19 -to OVGA[20]
set_location_assignment PIN_AJ17 -to OVGA[21]
set_location_assignment PIN_AJ16 -to OVGA[22]
set_location_assignment PIN_AK16 -to OVGA[23]
set_location_assignment PIN_AK21 -to OVGA[28]
set_location_assignment PIN_AK26 -to OVGA[8]
set_location_assignment PIN_AJ25 -to OVGA[9]
set_location_assignment PIN_AH25 -to OVGA[10]
set_location_assignment PIN_AK24 -to OVGA[11]
set_location_assignment PIN_AJ24 -to OVGA[12]
set_location_assignment PIN_AH24 -to OVGA[13]
set_location_assignment PIN_AK23 -to OVGA[14]
