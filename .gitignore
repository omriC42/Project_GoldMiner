#============================================================================
# Quartus Compilation Databases and Directories
#============================================================================
db/
incremental_db/
hc_output/
greybox_tmp/
# output_files: ignore the compile results, but KEEP SignalTap (.stp) and the programmer chains (.cdf)
# ("**/" = in every folder; a plain "output_files/" would hide the .stp too)
**/output_files/*
!**/output_files/*.stp
!**/output_files/*.cdf
c5_pin_model_dump.txt

